# --- App (vão para o navegador) ---
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Banco (só para migrações via psql; NUNCA use prefixo NEXT_PUBLIC_) ---
# Supabase → Connect → Session pooler. Caracteres especiais da senha em percent-encoding (@ → %40).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
